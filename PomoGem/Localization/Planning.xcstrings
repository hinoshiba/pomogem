    "1回の集中を完走する想定で、週あたりの回数から試算します。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimates assume you complete each focus session, based on how many you do a week."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の集中を完走する想定で、週あたりの回数から試算します。"
          }
        }
      }
    },
    "1回の集中時間" : {
      "comment" : "Plan control: the length of one focus session",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus Session Length"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1回の集中時間"
          }
        }
      }
    },
    "1年を平均365.25日として週回数を換算し、1回の完走を1粒、集中1分を%lldgとして計算します。2.50kgごとの瓶の満杯、長期の質量段階、瓶の光は実画面と同じ計算です。10個ずつまとめるため、長期間でも描画する可動体は%lld体以内です。" : {
      "comment" : "Plan: calculation assumptions; the arguments are grams per minute and the physics body limit",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weekly sessions are converted with an average year of 365.25 days. Each completed session is 1 gem, and each minute of focus is %1$lld g. A full jar every 2.50 kg, the long-term mass stages and the jar's light are calculated just as on the real screens. Gems are grouped in tens, so even a long plan draws no more than %2$lld moving pieces."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1年を平均365.25日として週回数を換算し、1回の完走を1粒、集中1分を%lldgとして計算します。2.50kgごとの瓶の満杯、長期の質量段階、瓶の光は実画面と同じ計算です。10個ずつまとめるため、長期間でも描画する可動体は%lld体以内です。"
          }
        }
      }
    },
    "60分 = 600g = 25分×2 + 10分 = 10分×6" : {
      "comment" : "Formula: 60 minutes are 600 g however they are split",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60 min = 600 g = 25 min × 2 + 10 min = 10 min × 6"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "60分 = 600g = 25分×2 + 10分 = 10分×6"
          }
        }
      }
    },
    "BOTTLE CYCLE" : {
      "comment" : "Eyebrow above the jar-cycle title (shown uppercased). en: 'Jar Cycle', never 'bottle'.",
