          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld粒"
          }
        }
      }
    },
    "✦ 金の粒が出た！ +%@" : {
      "comment" : "Toast for a gold gem (rare reward). %@ is the mass with its unit, e.g. 250g",
      "localizations" : {
