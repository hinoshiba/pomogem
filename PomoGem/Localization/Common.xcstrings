    "%lld〜%lld分" : {
      "comment" : "Range of custom focus lengths. %1$lld is the shortest and %2$lld the longest length in minutes. en: '%1$lld–%2$lld min'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld–%2$lld min"
