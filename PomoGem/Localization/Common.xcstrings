{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ +250g 積んだ" : {
      "comment" : "Toast after a 25-minute focus. %@ is the theme name the gem was added to",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added 250 g to %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ +250g 積んだ"
          }
        }
      }
    },
    "%@g" : {
      "comment" : "Mass in grams. %@ is the number, already formatted. en: '%@ g' (with a space; never converted to ounces).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ g"
          }
        },
        "ja" : {
          "stringUnit" : {
