    "iCloudに保存したポモジェムのデータは、iPhoneの「設定」アプリから削除できます。同じApple Accountのすべての端末から消え、元に戻せません。" : {
      "comment" : "設定 is the iOS Settings app",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can delete the PomoGem data saved in iCloud from the Settings app on your iPhone. It disappears from every device using the same Apple Account and can't be restored."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudに保存したポモジェムのデータは、iPhoneの「設定」アプリから削除できます。同じApple Accountのすべての端末から消え、元に戻せません。"
          }
        }
      }
    },
    "iCloudのデータを削除する" : {
      "comment" : "Section header: delete the app's data from iCloud in iOS Settings",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete Your iCloud Data"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudのデータを削除する"
          }
        }
      }
    },
    "iCloudへ接続できる状態で実行してください。通信が切れた場合は完了と表示せず、安全な位置から再試行します。" : {
      "comment" : "Complete data deletion precondition",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do this while you can connect to iCloud. If the connection drops, the app doesn't report the deletion as complete, and it tries again from a safe point."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudへ接続できる状態で実行してください。通信が切れた場合は完了と表示せず、安全な位置から再試行します。"
          }
        }
      }
    },
