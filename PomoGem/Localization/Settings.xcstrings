      "comment" : "Footer under the default timer orientation options. The argument is the automatic option's title (自動). 上・右・下・左 are the other four options: which way the top of the timer faces on an upright iPhone.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” follows how you hold your iPhone. Up, Right, Down and Left are the way the top of the timer faces on an iPhone held upright."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は端末の向きに合わせます。上・右・下・左は、縦に持ったiPhoneの画面内でタイマーの上辺が向く方向です。"
          }
        }
      }
    },
