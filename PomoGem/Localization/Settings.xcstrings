{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@\n変更前の状態に戻しました。\n%@" : {
      "comment" : "Settings error. The first argument is what failed (a full sentence), the second the system error description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@\nYour change was undone.\n%2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n変更前の状態に戻しました。\n%@"
          }
        }
      }
    },
    "%@。%@" : {
      "comment" : "VoiceOver label of a picker option: its name, then its description\nVoiceOver option label: option title, then its detail as a sentence. en: '%1$@. %2$@'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。%@"
          }
        }
      }
    },
    "%@を書き出し中" : {
      "comment" : "Export progress; the argument is the kind of record being written, e.g. focus sessions",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporting %@…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を書き出し中"
          }
        }
      }
    },
    "%@を書き出し中、%lld件中%lld件" : {
      "comment" : "Export progress. The first argument is the kind of record being written, the second the estimated total, the third how many are done",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporting %1$@: %3$lld of %2$lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を書き出し中、%lld件中%lld件"
          }
        }
      }
    },
    "%lld件のデータを書き出しました。保存先を選んでください" : {
      "comment" : "VoiceOver announcement after an export; the argument is the number of records written",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Exported %lld record. Choose where to save the file."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Exported %lld records. Choose where to save the file."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件のデータを書き出しました。保存先を選んでください"
          }
        }
      }
    },
    "1. このApple Accountでポモジェムを使っているすべての端末で、アプリを削除します。" : {
      "comment" : "Step 1 of deleting the iCloud data",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Delete the app on every device that uses PomoGem with this Apple Account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. このApple Accountでポモジェムを使っているすべての端末で、アプリを削除します。"
          }
        }
      }
    },
    "1〜%lld文字で入力してください。" : {
      "comment" : "Theme name field status when empty; the argument is the longest allowed name (20)",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Enter up to %lld character."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Enter 1–%lld characters."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1〜%lld文字で入力してください。"
          }
        }
      }
    },
    "2. iPhoneの「設定」を開き、いちばん上の自分の名前から「iCloud」に進みます。" : {
      "comment" : "Step 2 of deleting the iCloud data; quote iOS Settings as it reads in the language",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Open Settings on your iPhone, tap your name at the top, then tap “iCloud.”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. iPhoneの「設定」を開き、いちばん上の自分の名前から「iCloud」に進みます。"
          }
        }
      }
    },
    "3. 「アカウントのストレージを管理」（または「ストレージを管理」）で「ポモジェム」を選び、データを削除します。" : {
      "comment" : "Step 3 of deleting the iCloud data; アカウントのストレージを管理 / ストレージを管理 are iOS Settings labels (Manage Account Storage / Manage Storage)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. In “Manage Account Storage” (or “Manage Storage”), choose “PomoGem” and delete its data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. 「アカウントのストレージを管理」（または「ストレージを管理」）で「ポモジェム」を選び、データを削除します。"
          }
        }
      }
    },
    "3秒後にプレビューします。もう一度押すとキャンセルできます" : {
      "comment" : "VoiceOver announcement when the preview starts",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview in 3 seconds. Tap again to cancel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3秒後にプレビューします。もう一度押すとキャンセルできます"
          }
        }
      }
    },
    "3秒後に試す" : {
      "comment" : "Button: play the timer end sound and haptics in 3 seconds",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try in 3 Seconds"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3秒後に試す"
          }
        }
      }
    },
    "4つの見本から、タイマーの見た目を選べます" : {
      "comment" : "VoiceOver hint of the timer display row",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose how the timer looks from 4 samples."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4つの見本から、タイマーの見た目を選べます"
          }
        }
      }
    },
    "App Storeで評価・レビューする" : {
      "comment" : "Settings row: rate or review the app",
      "localizations" : {
        "en" : {
          "stringUnit" : {
