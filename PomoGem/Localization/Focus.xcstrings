        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この選択でタイマーへ"
          }
        }
      }
    },
    "この音楽を選んでおきます。今は再生しません" : {
      "comment" : "VoiceOver hint of a music row while Apple Music cannot play: the tap only remembers the choice",
      "localizations" : {
        "en" : {
