{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@  ·  %lld%% 残り" : {
      "comment" : "Ring status: 1 = FOCUS, BREAK or the paused word; 2 = percent of time left",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@  ·  %2$lld%% left"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@  ·  %lld%% 残り"
          }
        }
      }
    },
    "%@、%lldパーセント残り" : {
      "comment" : "VoiceOver value of the timer ring. 1 = time left, e.g. 残り24分59秒 (24 minutes, 59 seconds left); 2 = percent left.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$lld percent remaining"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%lldパーセント残り"
          }
        }
      }
    },
    "%@、%lldパーセント残り、一時停止中" : {
      "comment" : "VoiceOver value of the paused timer ring. 1 = time left, e.g. 残り24分59秒 (24 minutes, 59 seconds left); 2 = percent left.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$lld percent remaining, paused"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%lldパーセント残り、一時停止中"
          }
        }
      }
    },
    "%@集中" : {
      "comment" : "Timer header: the focus length. %@ is a duration, e.g. 25分 (25 min).",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Focus · %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@集中"
          }
        }
      }
    },
    "%lld%% 残り" : {
