    "NSAlarmKitUsageDescription" : {
      "comment" : "Alarms permission prompt (iOS 26+): why the end of a focus or break may ring as a system alarm. Suggested English: Used to ring an alarm when a focus or break ends, even in silent mode or a Focus.",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中や休憩の終わりを、マナーモードや集中モード中でもアラームでお知らせするために使います。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Apple Music permission prompt: why the timer controls the Music app (focus background music)",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイマー画面から『ミュージック』アプリで集中用の音楽を再生するために使います。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Motion permission prompt: why the jar reacts to tilting and shaking",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の傾きや振る操作に合わせて瓶の粒を動かすために使います。値は保存・送信しません。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Photos permission prompt: why a share card is saved to Photos",
      "extractionState" : "manual",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェアカードを写真に保存します。"
          }
        }
      }
    }
  },
  "version" : "1.0"
