{
  "sourceLanguage" : "ja",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Name under the app icon on the Home Screen and in Settings",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PomoGem"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポモジェム"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription" : {
      "comment" : "Alarms permission prompt (iOS 26+): why the end of a focus or break may ring as a system alarm. Suggested English: Used to ring an alarm when a focus or break ends, even in silent mode or a Focus.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to sound an alarm when a focus or break ends, even in Silent mode or a Focus."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中や休憩の終わりを、マナーモードや集中モード中でもアラームでお知らせするために使います。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Apple Music permission prompt: play focus music and choose playlists from the personal library",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to play focus music and let you choose playlists from your music library."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中用の音楽を再生し、自分のライブラリからプレイリストを選ぶために使います。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "comment" : "Motion permission prompt: why the jar reacts to tilting and shaking",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to move the gems in your jar as you tilt or shake your iPhone. Motion readings are never saved or sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端末の傾きや振る操作に合わせて瓶の粒を動かすために使います。値は保存・送信しません。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Photos permission prompt: why a share card is saved to Photos",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves your share cards to Photos."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェアカードを写真に保存します。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}