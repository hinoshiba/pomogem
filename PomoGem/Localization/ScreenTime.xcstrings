        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリの選択・未取り込みの利用記録・黒い石を削除し、自動記録を停止して、集中中のアプリ制限もオフにします。保存済みの勉強時間と粒は残ります。"
          }
        }
      }
    },
