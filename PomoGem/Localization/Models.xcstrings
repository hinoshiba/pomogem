    },
    "250gごとの抽選%lld回（%@）" : {
      "comment" : "%1$lld draws (one per 250 g; always 2 or more here) and %2$@ their results, e.g. 通常3・金1",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld draws (one per 250 g): %2$@"
