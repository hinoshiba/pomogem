{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@に、集中を思い出す通知を受け取る" : {
      "comment" : "Onboarding reminder toggle detail; %@ is the reminder time, e.g. 20:00 / 8:00 PM",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a reminder to focus at %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に、集中を思い出す通知を受け取る"
          }
        }
      }
    },
    "%@の集中 = この一粒（+%@）" : {
      "comment" : "Onboarding trial drop, shown after the trial gem lands: what one gem stands for. %1$@ is a focus time (25分), %2$@ its mass (250g). en: '%1$@ of focus = this gem (+%2$@)'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of focus = this gem (+%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の集中 = この一粒（+%@）"
          }
        }
      }
    },
    "%@の集中が、この一粒（%@）になります" : {
      "comment" : "VoiceOver: what the onboarding trial gem stands for. %1$@ is a spoken focus time, %2$@ a spoken mass",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ of focus becomes this gem (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の集中が、この一粒（%@）になります"
          }
        }
      }
    },
    "%@を選択から外す" : {
      "comment" : "VoiceOver: remove the typed theme %@ from the selection",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove %@ from your selection"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を選択から外す"
          }
        }
      }
    },
    "%lld件" : {
      "comment" : "Restore waiting screen: a received count",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld件"
          }
        }
      }
    },
    "%lld粒、0グラム" : {
      "comment" : "VoiceOver value of the trial jar; %lld is its gem count (0 or 1), which always weighs 0 grams",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld gem, 0 grams"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld gems, 0 grams"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld粒、0グラム"
          }
        }
      }
    },
    "25・45・60・90分のタイマーは無料" : {
      "comment" : "Onboarding page 1: the 25, 45, 60 and 90 minute timers are free",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25, 45, 60 and 90 min timers are free"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25・45・60・90分のタイマーは無料"
          }
        }
      }
    },
    "YOUR BOTTLE" : {
      "comment" : "Decorative uppercase eyebrow above 最初のテーマを選ぶ. en: YOUR JAR (glossary: jar, never bottle)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOUR JAR"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YOUR BOTTLE"
          }
        }
      }
    },
    "iCloudから記録を復元しています" : {
      "comment" : "Restore waiting screen: title while an earlier jar arrives from iCloud",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restoring from iCloud"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから記録を復元しています"
          }
        }
      }
    },
    "iCloudの記録は、届きしだいこのiPhoneにも表示されます。" : {
      "comment" : "Onboarding page 1 after choosing to start fresh over an iCloud restore",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iCloud records will appear on this iPhone as soon as they arrive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudの記録は、届きしだいこのiPhoneにも表示されます。"
          }
        }
      }
    },
    "subject.untitled-name" : {
      "comment" : "Name shown for a theme that has no name",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマ"
          }
        }
      }
    },
    "「%@」を選択しています。" : {
      "comment" : "Onboarding: the typed theme %@ is already selected",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is already selected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を選択しています。"
          }
        }
      }
    },
    "あと%lld文字入力できます" : {
      "comment" : "Theme name field: %lld characters left",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld character left"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld characters left"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと%lld文字入力できます"
          }
        }
      }
    },
    "あとから設定で変更できます。抽選しない間は乱数を使わず、その間の質量も抽選用には貯めません。既存の端数と保証カウントは停止します" : {
      "comment" : "Rare gem disclosure: changeable later in Settings; with no draws, nothing random is used",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change this later in Settings. While draws are off, nothing random is used and no mass is saved up for draws. The existing remainder and guarantee count pause"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとから設定で変更できます。抽選しない間は乱数を使わず、その間の質量も抽選用には貯めません。既存の端数と保証カウントは停止します"
          }
        }
      }
    },
    "あとで設定から追加・編集できます。" : {
      "comment" : "Onboarding theme page: themes can be added and edited later in Settings",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can add and edit themes later in Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あとで設定から追加・編集できます。"
          }
        }
      }
    },
    "このApple Accountの以前の瓶を、iCloudから受け取っています。記録が届きはじめると自動で瓶がひらき、残りの記録もそのあと順に届きます。" : {
      "comment" : "Restore waiting screen: what is happening and what happens next",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your earlier jar from this Apple Account is arriving from iCloud. The jar opens by itself as soon as records start to arrive, and the rest keep arriving after that."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple Accountの以前の瓶を、iCloudから受け取っています。記録が届きはじめると自動で瓶がひらき、残りの記録もそのあと順に届きます。"
          }
        }
      }
    },
    "このあとはホームで時間を選び、開始ボタンをタップ。テーマはいつでも変更できます。" : {
      "comment" : "Onboarding theme page: what happens next on Home",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Next, choose a length on Home and tap Start. You can change the theme anytime."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このあとはホームで時間を選び、開始ボタンをタップ。テーマはいつでも変更できます。"
          }
        }
      }
    },
    "この画面を開いたままお待ちください。" : {
      "comment" : "Restore waiting screen: keep the app open while records arrive",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please keep this screen open while you wait."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面を開いたままお待ちください。"
          }
        }
      }
    },
    "これはお試しなので、記録には入りません。「次へ」で省略できます。" : {
      "comment" : "Onboarding trial drop page: the trial gem is never recorded, and the page can be skipped",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is a trial, so it won't be added to your records. You can skip it with Next."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはお試しなので、記録には入りません。「次へ」で省略できます。"
          }
        }
      }
    },
    "しばらく新しい記録が届いていません。通信状態を確認するか、待たずに「新しく始める」を選べます。" : {
      "comment" : "Restore waiting screen: shown when nothing new has arrived for a while",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No new records have arrived for a while. Check your connection, or choose “Start Fresh” instead of waiting."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらく新しい記録が届いていません。通信状態を確認するか、待たずに「新しく始める」を選べます。"
          }
        }
      }
    },
    "ためしに一粒、落としてみる" : {
      "comment" : "Trial page button: drop a trial gem",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a Trial Gem"
