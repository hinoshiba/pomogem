    "iCloudから記録を復元しています" : {
      "comment" : "Restore waiting screen: title while an earlier jar arrives from iCloud",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloudから記録を復元しています"
