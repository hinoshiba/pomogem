        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ためしに一粒、落としてみる"
          }
        }
      }
    },
    "ためしの一粒が瓶に積もりました" : {
      "comment" : "VoiceOver label of the trial jar after the gem landed",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trial gem landed in the jar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ためしの一粒が瓶に積もりました"
          }
        }
      }
    },
    "ためしの一粒が瓶の中を落下しています" : {
      "comment" : "VoiceOver label of the trial jar while the gem falls",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The trial gem is falling into the jar"
