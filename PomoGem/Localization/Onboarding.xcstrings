    },
    "テーマ名は%lld文字以内で入力してください（%lld文字超過）。" : {
      "comment" : "Theme name validation: %1$lld is the character limit (always 40), %2$lld how many characters too many",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theme names can be up to %1$lld characters (%2$lld over)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テーマ名は%lld文字以内で入力してください（%lld文字超過）。"
          }
        }
      }
    },
    "テーマ名を入力してください。" : {
      "comment" : "Theme name validation: the name is empty",
      "localizations" : {
