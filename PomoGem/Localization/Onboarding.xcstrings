      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "届いた記録：テーマ%1$lld件。経過時間%2$lld分%3$lld秒"
          }
        }
      }
    },
    "待つ" : {
      "comment" : "Restore waiting screen: keep waiting for iCloud (cancel)"
