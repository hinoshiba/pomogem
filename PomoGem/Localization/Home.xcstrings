{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ %@ → +%@の一粒" : {
      "comment" : "Completion card main line. %1$@ is the theme name (user data, never translated), %2$@ the focus time (25分), %3$@ the gem's mass (250g). en: '%1$@ %2$@ → a +%3$@ gem'",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@ → +%3$@の一粒"
          }
        }
      }
    },
    "%@ +%@ 積んだ" : {
      "comment" : "Toast after a gem of another mass lands: theme, mass (+1125g); like Common's 「%@ +250g 積んだ」",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Added %2$@ to %1$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ +%@ 積んだ"
          }
        }
      }
    },
    "%@ +%@（%@）" : {
      "comment" : "Completion card: the theme, the mass this focus added (+250g) and the same in standard units",
