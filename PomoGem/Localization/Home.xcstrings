    "%@。%@の重さになりました" : {
      "comment" : "Weight Journey chip when a landmark (名所) is reached. %1$@ the landmark's name (2時間, 最初の一粒, ゾウ1頭ぶん), %2$@ its weight comparison (キャベツ1玉ほど). Never claims an exact balance. Suggested en: '%1$@. Now about as heavy as %2$@.'",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@。%2$@の重さになりました"
