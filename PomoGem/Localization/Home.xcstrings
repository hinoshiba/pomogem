{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@ / %@" : {
      "comment" : "Jar rail: focus time so far / time the next time core needs",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ / %@"
          }
        }
      }
    },
    "%@。累計%@、集中%lld粒、記念石%@個" : {
      "comment" : "VoiceOver, menu metrics while iCloud is checked: status, lifetime mass, focus count, achievement stone count",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。累計%@、集中%lld粒、記念石%@個"
          }
        }
      }
    },
    "%@。累計は確認が済むと表示します。この端末で確認済みの集中%lld粒、記念石%@個" : {
      "comment" : "VoiceOver, menu metrics while iCloud is checked and no lifetime total can be shown: status, focus count, achievement stone count",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。累計は確認が済むと表示します。この端末で確認済みの集中%lld粒、記念石%@個"
          }
        }
      }
    },
    "%@に%@、%@を積みます。「元に戻す」で取り消せます" : {
      "comment" : "VoiceOver, once the Undo banner of a manual entry has focus: theme, duration, grams",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に%@、%@を積みます。「元に戻す」で取り消せます"
          }
        }
      }
    },
    "%@に%@を積みます" : {
      "comment" : "Undo banner after a manual entry: theme, then the self-reported time about to be added",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に%@を積みます"
          }
        }
      }
    },
    "%@の自己申告を保存できませんでした。もう一度積んでください" : {
      "comment" : "Toast when a confirmed manual entry could not be saved; the argument is the theme",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の自己申告を保存できませんでした。もう一度積んでください"
          }
        }
      }
    },
    "%@まで" : {
      "comment" : "Jar rail caption; the argument is 最初の時間の核 or 時間の核・N段目",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@まで"
          }
        }
      }
    },
    "%lld粒が、ひとつの結晶になった" : {
      "comment" : "Toast after ten gems fuse; the argument is the gem count",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld粒が、ひとつの結晶になった"
          }
        }
      }
    },
    "%lld粒の結晶、%@" : {
      "comment" : "VoiceOver, crystal inspection card: gems inside, then what its detail shows",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld粒の結晶、%@"
          }
        }
      }
    },
    "+%@ ・ まもなく瓶に入ります" : {
      "comment" : "Undo banner subtitle: the mass, and that the entry is saved shortly",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "+%@ ・ まもなく瓶に入ります"
          }
        }
      }
    },
    "Proなら、この%@に「%@」と刻めます" : {
      "comment" : "Fusion sheet link for free users; arguments: the crystal's name (結晶…), the month it was made (2026年9月)",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proなら、この%@に「%@」と刻めます"
          }
        }
      }
    },
    "あと%lld%%で、下の粒がひとつの結晶に" : {
      "comment" : "Jar capsule before a fusion; the argument is the remaining capacity percent",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あと%lld%%で、下の粒がひとつの結晶に"
