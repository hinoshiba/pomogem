        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。この端末で確認できた記録だけを表示しています"
          }
        }
      }
    },
    "%@。今回の%@は保存済みです。これまでの合計は確認が済むと表示します" : {
