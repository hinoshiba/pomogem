    },
    "Apple AccountとiCloudを確認できません。確認が済むまで同期を停止します。利用できる端末データがある場合はオフラインで続けられます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't verify your Apple Account and iCloud. Sync stays stopped until they're verified. If this device has data you can use, you can continue offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple AccountとiCloudを確認できません。確認が済むまで同期を停止します。利用できる端末データがある場合はオフラインで続けられます。"
          }
        }
      }
    },
    "Apple Accountの再確認" : {
      "comment" : "iCloud check failure, the step that failed: identifying the Apple Account again",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Account recheck"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Accountの再確認"
          }
        }
      }
    },
    "Apple Accountの変更を確認しています" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking the Apple Account change"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Accountの変更を確認しています"
          }
        }
      }
    },
    "Apple Accountの状態" : {
      "comment" : "iCloud check failure, the step that failed: reading the Apple Account status",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Account status"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Accountの状態"
          }
        }
      }
    },
    "Apple Accountの状態が変わったため、どのApple Accountでサインインしているかを確認するまで、この端末に保存したデータは開きません。通信が使える場所で「もう一度試す」をタップしてください。記録は消えていません。" : {
      "comment" : "「もう一度試す」 is the launch screen's Try Again button",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple Account status changed, so the data saved on this device won't open until the app confirms which Apple Account you're signed in with. Somewhere with a connection, tap “Try Again”. Your records have not been lost."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Accountの状態が変わったため、どのApple Accountでサインインしているかを確認するまで、この端末に保存したデータは開きません。通信が使える場所で「もう一度試す」をタップしてください。記録は消えていません。"
          }
        }
      }
    },
    "Apple Accountの識別" : {
      "comment" : "iCloud check failure, the step that failed: identifying the Apple Account",
