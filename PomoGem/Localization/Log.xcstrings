{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@、%@" : {
      "comment" : "VoiceOver: the period (今週 or 今月), then its date range",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@"
          }
        }
      }
    },
    "%@、%@、%@、プラス%lldグラム%@、%@" : {
      "comment" : "VoiceOver history row: theme, gem kind, how recorded, grams added, optional rare summary, date",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@、%@、プラス%lldグラム%@、%@"
          }
        }
      }
    },
