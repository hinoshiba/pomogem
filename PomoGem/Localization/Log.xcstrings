{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@t" : {
      "comment" : "Mass in metric tonnes; the argument is the number, already formatted (e.g. 1.2). en: '%@ t'.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ t"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@t"
          }
        }
      }
    },
    "%@、%@" : {
      "comment" : "VoiceOver: two parts read together, e.g. a period and its date range, or a day and its spoken mass",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@"
          }
        }
      }
    },
