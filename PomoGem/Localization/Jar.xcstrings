  "strings" : {
    "%@、%@の記念石、質量には含まれません" : {
      "comment" : "VoiceOver, a milestone stone in the jar: the theme's name, then the milestone's title; the stone adds no mass",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@、%2$@の記念石、質量には含まれません"
          }
        }
      }
    },
    "%@。「最新の結晶の内訳を見る」アクションで、保存されている粒数や質量などを確認できます" : {
      "comment" : "VoiceOver jar hint: the tap/tilt hint, then the custom action that opens the newest crystal"
    },
    "%@。この端末で確認済みの集中時間の質量：%@" : {
