{
  "sourceLanguage" : "ja",
  "strings" : {
    "%@、%@" : {
      "comment" : "VoiceOver, jar value with black stones: the jar's study value (ends with the milestone stone count, no period), then the black stones sentence. en: '%1$@. %2$@'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@"
          }
        }
      }
    },
    "%@、%@。" : {
      "comment" : "VoiceOver, the jar's black stones: the stone count, then the 10-minute stones they stand for. en: '%1$@, %2$@.'",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@。"
          }
        }
      }
    },
    "%@、%@の記念石、質量には含まれません" : {
      "comment" : "VoiceOver, a milestone stone in the jar: the theme's name, then the milestone's title; the stone adds no mass",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, milestone stone: %2$@, adds no mass"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@の記念石、質量には含まれません"
          }
        }
      }
    },
    "%@。「最新の結晶の内訳を見る」アクションで、保存されている粒数や質量などを確認できます" : {
      "comment" : "VoiceOver jar hint: the tap/tilt hint, then the custom action that opens the newest crystal",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Use the “View Newest Crystal Details” action to check its saved gem count, mass and more"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。「最新の結晶の内訳を見る」アクションで、保存されている粒数や質量などを確認できます"
          }
        }
      }
    },
    "%@。この端末で確認済みの集中時間の質量：%@。" : {
      "comment" : "VoiceOver, jar while iCloud is checked: status, the lifetime mass",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. Mass of focus time confirmed on this device: %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。この端末で確認済みの集中時間の質量：%@。"
          }
        }
      }
    },
    "%@。この端末で確認済みの集中時間の質量：%@以上。" : {
      "comment" : "VoiceOver, jar while iCloud is checked: status, a lower bound of the lifetime mass",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@. Mass of focus time confirmed on this device: at least %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。この端末で確認済みの集中時間の質量：%@以上。"
          }
        }
      }
    },
    "%@。これまでの合計は確認が済むと表示します。" : {
      "comment" : "VoiceOver, jar while iCloud is checked and no lifetime total can be shown: status",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Your total so far appears once the check is done."
